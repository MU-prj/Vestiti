# Copy to .env and fill in real values. NEVER commit real credentials.

# --- PostgreSQL ---
POSTGRES_USER=camerino
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=camerino
DATABASE_URL=postgresql+asyncpg://camerino:change-me-dev-only@localhost:5432/camerino

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO / S3 (image storage) ---
MINIO_ROOT_USER=camerino
MINIO_ROOT_PASSWORD=change-me-dev-only
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=camerino-media

# --- External providers (leave empty in dev; mocks run in CI) ---
# fal.ai key for the FASHN try-on provider (phase 6)
FAL_KEY=
# Affiliate network credentials (phase 2)
AWIN_API_TOKEN=
CJ_API_TOKEN=
IMPACT_API_TOKEN=
RAKUTEN_API_TOKEN=
# Shopify Storefront API (phase 2)
SHOPIFY_STOREFRONT_TOKEN=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
