# Camerino environment template. Copy to .env and fill in real values.
# NEVER commit real credentials: CI runs gitleaks and will fail the build.

# --- Database ---
DATABASE_URL=postgresql+psycopg://camerino:camerino@localhost:5432/camerino

# --- Redis (ARQ job queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, any S3-compatible in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=camerino
S3_SECRET_KEY=camerino-secret
S3_BUCKET=camerino

# --- User photo encryption at rest (Fernet key, generate with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ---
PHOTO_ENCRYPTION_KEY=

# --- Virtual try-on (fal.ai FASHN). Leave empty to use the mock provider. ---
FAL_KEY=

# --- Affiliate networks (leave empty to use mock adapters) ---
AWIN_API_TOKEN=
CJ_API_TOKEN=
IMPACT_API_TOKEN=

# --- Shopify Storefront API (per-shop tokens are stored per source) ---
SHOPIFY_STOREFRONT_TOKEN=

# --- Email notifications (leave empty to use the mock notifier) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@example.com

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
